# ── Odoo ──────────────────────────────────────
ODOO_URL=https://tuempresa.odoo.com
ODOO_DB=tuempresa
ODOO_USER=tu@email.com
ODOO_PASSWORD=tu_contraseña_odoo

# ── Cache (segundos) ──────────────────────────
# 900 = 15 minutos | 1800 = 30 minutos
CACHE_TTL_SECONDS=900

# Cloudflare Access. Mientras estas dos esten vacias el middleware NO bloquea
# nada (para que un deploy no pueda dejar a todos afuera). Con las dos
# cargadas, solo pasan los requests que vienen firmados por Cloudflare, o sea
# los que entran por app.kaironsrl.com.ar.
#   TEAM_DOMAIN: Zero Trust > Settings > Custom Pages (ej: kairon.cloudflareaccess.com)
#   AUD: Zero Trust > Access > Applications > la app > Application Audience Tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
